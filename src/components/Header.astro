---
import { nyelvAz, parja } from '../i18n/utak';

/** Menüpont a lenyíló panelben. */
interface Almenu {
  href: string;
  cim: string;
  /** Külső link: új lapon nyílik, rel="noopener noreferrer"-rel. */
  kulso?: boolean;
}

/**
 * Főmenüpont. Vagy `href`-fel közvetlen link (pl. GYIK),
 * vagy `al`-lal lenyíló panel — a kettő kizárja egymást.
 */
type Fomenu =
  | { cim: string; href: string; kulso?: boolean; al?: undefined }
  | { cim: string; href?: undefined; al: Almenu[] };

const menu: Fomenu[] = [
  {
    cim: 'Szolgáltatások',
    al: [
      { href: '/szolgaltatasok/iaas/', cim: 'IaaS – Bérelt infrastruktúra' },
      { href: '/szolgaltatasok/dcaas/', cim: 'DCaaS – Bérelt adatközpont' },
      { href: '/szolgaltatasok/saas/', cim: 'SaaS – Alkalmazás-hosting' },
      { href: '/szolgaltatasok/menedzselt-it-uzemeltetes/', cim: 'Menedzselt IT üzemeltetés' },
      { href: '/szolgaltatasok/helyi-uzemeltetes/', cim: 'Helyi és hibrid IT-üzemeltetés' },
      { href: '/szolgaltatasok/audit-restore-validation/', cim: 'Audit Restore Validation és Visszaállítási Tesztek' },
    ],
  },
  {
    cim: 'Technológia',
    al: [
      { href: '/szolgaltatasok/helyi-uzemeltetes/#platform-katalogus', cim: 'Mit üzemeltetünk — platform-katalógus' },
      { href: '/technologia/', cim: 'Technológia áttekintés' },
      { href: '/partnerek/', cim: 'Partnerek — gyártói háttér' },
    ],
  },
  {
    cim: 'Biztonság',
    al: [
      { href: '/biztonsag/', cim: 'Biztonsági megközelítés' },
      { href: '/esettanulmanyok/', cim: 'Esettanulmányok' },
      { href: '/sox-megfeleles/', cim: 'SOX és ITGC — amerikai tőzsdei cégeknek' },
    ],
  },
  {
    cim: 'Blog',
    // A bejegyzések a lista tetejéről, dátum szerint csökkenő sorrendben.
    // Új cikknél ide is kerüljön be egy — a cikk címénél rövidebb — menücím.
    al: [
      { href: '/blog/', cim: 'Összes bejegyzés' },
      { href: '/blog/mcp-az-ai-usb-c-je/', cim: 'MCP — az AI USB-C-je' },
      { href: '/blog/arnyek-ai-ingyenes-eszkozok/', cim: 'Árnyék-AI a cégben' },
      { href: '/blog/biztonsagtudatossag-knowbe4-nis2-dora/', cim: 'Amit az auditor kérdez' },
      { href: '/blog/mennyi-ideig-birja-rendszer-nelkul/', cim: 'Mennyi ideig bírja rendszer nélkül?' },
      { href: '/blog/ai-ugynokok-cselekvo-mi/', cim: 'Az AI már cselekszik is' },
      { href: '/blog/ai-az-irodaban-jogosultsagok/', cim: 'AI az irodában: mit lát valójában?' },
      { href: '/blog/uj-honlap/', cim: 'Megújult a triox.hu' },
      { href: '/blog/ai-csalas-hangklonozas/', cim: 'Amikor a csaló a főnök hangján hív' },
      { href: '/blog/microsoft-365-mentes-felelosseg/', cim: 'Amit a Microsoft nem ment el' },
      { href: '/blog/passkey-jelszo-nelkuli-belepes/', cim: 'A jelszó, amit nem lehet ellopni' },
    ],
  },
  {
    cim: 'Támogatás',
    al: [
      { href: 'https://support.triox.hu', cim: 'Támogatás partnereink részére', kulso: true },
      { href: 'https://rd.triox.hu', cim: 'Távsegítség', kulso: true },
    ],
  },
  {
    cim: 'Kapcsolat',
    al: [
      { href: '/rolunk/', cim: 'Rólunk' },
      { href: '/kapcsolat/', cim: 'Kapcsolati űrlap' },
      { href: 'mailto:info@triox.hu', cim: 'E-mail küldés' },
    ],
  },
  { cim: 'GYIK', href: '/gyik/' },
];

/** Az angol (/en/) menü: szerkezetre azonos a magyarral, angol útvonalakkal. */
const menuEn: Fomenu[] = [
  {
    cim: 'Services',
    al: [
      { href: '/en/services/iaas/', cim: 'IaaS – Leased infrastructure' },
      { href: '/en/services/dcaas/', cim: 'DCaaS – Leased data center' },
      { href: '/en/services/saas/', cim: 'SaaS – Application hosting' },
      { href: '/en/services/managed-it-operations/', cim: 'Managed IT operations' },
      { href: '/en/services/on-premises-and-hybrid-it/', cim: 'On-premises and hybrid IT operations' },
      { href: '/en/services/audit-restore-validation/', cim: 'Audit Restore Validation and Restore Testing' },
    ],
  },
  {
    cim: 'Technology',
    al: [
      { href: '/en/services/on-premises-and-hybrid-it/#platform-katalogus', cim: 'What we operate—platform catalog' },
      { href: '/en/technology/', cim: 'Technology overview' },
      { href: '/en/partners/', cim: 'Partners—vendor background' },
    ],
  },
  {
    cim: 'Security',
    al: [
      { href: '/en/security/', cim: 'Our security approach' },
      { href: '/en/case-studies/', cim: 'Case studies' },
      { href: '/en/sox-compliance/', cim: 'SOX and ITGC—for US-listed companies' },
    ],
  },
  {
    cim: 'Blog',
    al: [
      { href: '/en/blog/', cim: 'All posts' },
      { href: '/en/blog/mcp-the-usb-c-of-ai/', cim: 'MCP—the USB-C of AI' },
      { href: '/en/blog/shadow-ai-free-tools/', cim: 'Shadow AI in the company' },
      { href: '/en/blog/security-awareness-knowbe4-nis2-dora/', cim: 'What the auditor asks' },
      { href: '/en/blog/how-long-without-your-systems/', cim: 'How long can you run without your systems?' },
      { href: '/en/blog/ai-agents-that-act/', cim: 'AI now takes action' },
      { href: '/en/blog/ai-in-the-office-permissions/', cim: 'AI in the office: what does it really see?' },
      { href: '/en/blog/new-website/', cim: 'triox.hu has been relaunched' },
      { href: '/en/blog/ai-voice-cloning-fraud/', cim: 'When the scammer calls in your boss’s voice' },
      { href: '/en/blog/microsoft-365-backup-responsibility/', cim: 'What Microsoft doesn’t back up' },
      { href: '/en/blog/passkeys-passwordless-sign-in/', cim: 'The password that can’t be stolen' },
    ],
  },
  {
    cim: 'Support',
    al: [
      { href: 'https://support.triox.hu', cim: 'Support for our clients', kulso: true },
      { href: 'https://rd.triox.hu', cim: 'Remote assistance', kulso: true },
    ],
  },
  {
    cim: 'Contact',
    al: [
      { href: '/en/about/', cim: 'About us' },
      { href: '/en/contact/', cim: 'Contact form' },
      { href: 'mailto:info@triox.hu', cim: 'Send an email' },
    ],
  },
  { cim: 'FAQ', href: '/en/faq/' },
];

const most = Astro.url.pathname;
const nyelv = nyelvAz(most);
const aktivMenu = nyelv === 'en' ? menuEn : menu;

/** A fejléc nem menüs feliratai, nyelvenként. A burger-feliratokat a szkript a data-attribútumokból veszi. */
const felirat = {
  hu: { logo: 'Triox logó', fomenu: 'Fő menü', nyit: 'Menü megnyitása', zar: 'Menü bezárása', nyelvek: 'Nyelv' },
  en: { logo: 'Triox logo', fomenu: 'Main menu', nyit: 'Open menu', zar: 'Close menu', nyelvek: 'Language' },
}[nyelv];

/**
 * Nyelvválasztó zászlók. Mindkét zászló link: a saját nyelvé az aktuális
 * oldalra, a másiké az oldal párjára mutat. A `?nyelv=` paraméter rögzíti a
 * látogató választását (Base.astro fejszkriptje teszi el), így a böngésző
 * nyelvén alapuló automatikus átirányítás onnantól nem írja felül.
 * A felirat mindig az adott nyelven áll — aki nem érti az oldalt, a saját
 * nyelvén olvassa a választást.
 */
const zaszlok = [
  { kod: 'hu', felirat: 'Magyar', href: nyelv === 'hu' ? most : parja(most) },
  { kod: 'en', felirat: 'English (US)', href: nyelv === 'en' ? most : parja(most) },
].map((z) => ({ ...z, href: `${z.href}?nyelv=${z.kod}`, aktiv: z.kod === nyelv }));

// Az amerikai zászló 50 csillaga: 5 hatos és 4 ötös sor, váltakozva.
const csillagok: [number, number][] = [];
for (let sor = 0; sor < 9; sor++) {
  const db = sor % 2 === 0 ? 6 : 5;
  for (let i = 0; i < db; i++) {
    csillagok.push([0.633 + (sor % 2 === 0 ? 0 : 0.633) + i * 1.266, 0.538 + sor * 0.538]);
  }
}

/**
 * Egy panelen belül a legpontosabban illeszkedő menüpont kap kiemelést, nem
 * mindegyik illeszkedő: a bejegyzés saját oldalán a bejegyzés, a menüben nem
 * szereplő aloldalon pedig a gyűjtő ("Összes bejegyzés"). Enélkül a /blog/
 * minden cikkoldalon kiemelt lenne a cikk mellett.
 */
function aktivHref(al: Almenu[]): string | undefined {
  let talalat: string | undefined;
  for (const a of al) {
    // mailto: és külső hivatkozás — ezekre az útvonal sosem illeszkedik
    if (a.href.includes(':')) continue;
    if (!most.startsWith(a.href)) continue;
    if (talalat === undefined || a.href.length > talalat.length) talalat = a.href;
  }
  return talalat;
}
---

<header class="fej" data-menu="zarva">
  <div class="wrap fej__in">
    <a class="fej__brand" href={nyelv === 'en' ? '/en/' : '/'}>
      <img class="fej__logo" src="/logo.svg" alt={felirat.logo} width="32" height="32" />
      <span class="fej__nev">triox <em>informatika</em></span>
    </a>

    <nav class="nav-fej" id="fomenu" aria-label={felirat.fomenu}>
      {aktivMenu.map((m, i) => {
        const aktiv = m.al !== undefined ? aktivHref(m.al) : undefined;
        return (
        <div class="nav-elem">
          {m.href !== undefined ? (
            <a
              href={m.href}
              class="nav-gomb nav-gomb--link"
              target={m.kulso ? '_blank' : undefined}
              rel={m.kulso ? 'noopener noreferrer' : undefined}
            >{m.cim}</a>
          ) : (
            <>
              <button
                class="nav-gomb"
                aria-expanded="false"
                aria-controls={`panel-${i}`}
                data-idx={i}
              >
                {m.cim}
                <svg class="nav-nyil" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                  <polyline points="1,3.5 6,8.5 11,3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div id={`panel-${i}`} class="nav-panel" hidden>
                {m.al.map((a) => (
                  <a
                    href={a.href}
                    aria-current={a.href === aktiv ? 'page' : undefined}
                    target={a.kulso ? '_blank' : undefined}
                    rel={a.kulso ? 'noopener noreferrer' : undefined}
                  >{a.cim}</a>
                ))}
              </div>
            </>
          )}
        </div>
        );
      })}
    </nav>

    <div class="nyelvek" role="group" aria-label={felirat.nyelvek}>
      {zaszlok.map((z) => (
        <a
          class="zaszlo"
          href={z.href}
          hreflang={z.kod}
          lang={z.kod}
          title={z.felirat}
          aria-label={z.felirat}
          aria-current={z.aktiv ? 'true' : undefined}
          data-nyelv={z.kod}
        >
          {z.kod === 'hu' ? (
            <svg viewBox="0 0 6 3" aria-hidden="true">
              <rect class="hu-piros" width="6" height="1" />
              <rect fill="#fff" y="1" width="6" height="1" />
              <rect class="hu-zold" y="2" width="6" height="1" />
            </svg>
          ) : (
            <svg viewBox="0 0 19 10" aria-hidden="true">
              <rect fill="#fff" width="19" height="10" />
              {[0, 2, 4, 6, 8, 10, 12].map((s) => (
                <rect class="us-piros" y={(s * 10) / 13} width="19" height={10 / 13} />
              ))}
              <rect class="us-kek" width="7.6" height={70 / 13} />
              {csillagok.map(([x, y]) => <circle fill="#fff" cx={x} cy={y} r="0.19" />)}
            </svg>
          )}
        </a>
      ))}
    </div>

    <button
      class="burger"
      id="burger"
      type="button"
      aria-controls="fomenu"
      aria-expanded="false"
      aria-label={felirat.nyit}
      data-nyit={felirat.nyit}
      data-zar={felirat.zar}
    >
      <span class="burger__vonal" aria-hidden="true"></span>
      <span class="burger__vonal" aria-hidden="true"></span>
      <span class="burger__vonal" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const fej = document.querySelector<HTMLElement>('.fej')!;
  const burger = document.querySelector<HTMLButtonElement>('#burger')!;
  const elemek = Array.from(document.querySelectorAll<HTMLElement>('.nav-elem'));
  const mobil = window.matchMedia('(max-width: 62rem)');

  function zarOsszes(kiveve: HTMLElement | null = null) {
    elemek.forEach((el) => {
      if (el === kiveve) return;
      const g = el.querySelector<HTMLButtonElement>('.nav-gomb');
      const p = el.querySelector<HTMLElement>('.nav-panel');
      if (!p) return;
      g?.setAttribute('aria-expanded', 'false');
      p.hidden = true;
    });
  }

  function menutZar() {
    fej.dataset.menu = 'zarva';
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', burger.dataset.nyit ?? '');
    zarOsszes();
  }

  function menutNyit() {
    fej.dataset.menu = 'nyitva';
    burger.setAttribute('aria-expanded', 'true');
    burger.setAttribute('aria-label', burger.dataset.zar ?? '');
  }

  burger.addEventListener('click', (e) => {
    e.stopPropagation();
    if (fej.dataset.menu === 'nyitva') menutZar();
    else menutNyit();
  });

  elemek.forEach((el) => {
    const g = el.querySelector<HTMLButtonElement>('.nav-gomb')!;
    const p = el.querySelector<HTMLElement>('.nav-panel');

    // Direkt link (nincs panel): mobilon a menü záruljon be kattintásra.
    if (!p) {
      g.addEventListener('click', () => menutZar());
      return;
    }

    g.addEventListener('click', (e) => {
      e.stopPropagation();
      const nyitva = g.getAttribute('aria-expanded') === 'true';
      // Mobilon harmonika: több panel is nyitva lehet egyszerre.
      if (!mobil.matches) zarOsszes(nyitva ? null : el);
      g.setAttribute('aria-expanded', String(!nyitva));
      p.hidden = nyitva;
    });

    p.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) {
        menutZar();
        return;
      }
      e.stopPropagation();
    });
  });

  // A menü üres felületére kattintás ne zárja be a panelt.
  document.querySelector<HTMLElement>('.nav-fej')!.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('a')) e.stopPropagation();
  });

  document.addEventListener('click', () => {
    zarOsszes();
    menutZar();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const voltNyitva = fej.dataset.menu === 'nyitva';
    zarOsszes();
    menutZar();
    if (voltNyitva) burger.focus();
  });

  // Ha asztali méretre nő az ablak, a mobil állapot ne ragadjon be.
  mobil.addEventListener('change', () => menutZar());
</script>

<style>
  .fej {
    border-bottom: 1px solid var(--c-line);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .fej__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--h-fej);
  }
  .fej__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--c-ink);
    /* A nyelvváltó harmadik elemként áll a sorban — az auto margó tartja a
       menüt jobbra zárva, ahogy a váltó előtt volt. */
    margin-right: auto;
  }

  /* --- nyelvválasztó zászlók: a burger mellett mobilon is látszanak --- */

  .nyelvek {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
  }
  .zaszlo {
    display: grid;
    place-items: center;
    /* A kattintható felület nagyobb a zászlónál — érintőképernyőn is elérhető. */
    width: 2rem;
    height: 2rem;
    border-radius: var(--r);
    transition: background 0.15s;
  }
  .zaszlo svg {
    display: block;
    width: 1.35rem;
    height: 0.9rem;
    border-radius: 2px;
    /* Vékony keret, hogy a fehér sáv fehér fejlécen se olvadjon bele. */
    box-shadow: 0 0 0 1px rgba(22, 24, 29, 0.18);
    opacity: 0.5;
    filter: saturate(0.6);
    transition: opacity 0.15s, filter 0.15s;
  }
  .zaszlo:hover svg,
  .zaszlo:focus-visible svg,
  .zaszlo[aria-current='true'] svg {
    opacity: 1;
    filter: none;
  }
  .zaszlo:hover {
    background: var(--c-brand-wash);
  }
  /* Az aktuális nyelv: teljes szín és márkakék aláhúzás. */
  .zaszlo[aria-current='true'] {
    box-shadow: inset 0 -2px 0 var(--c-brand);
    border-radius: var(--r) var(--r) 0 0;
  }
  .hu-piros { fill: var(--c-zaszlo-hu-piros); }
  .hu-zold { fill: var(--c-zaszlo-hu-zold); }
  .us-piros { fill: var(--c-zaszlo-us-piros); }
  .us-kek { fill: var(--c-zaszlo-us-kek); }
  .fej__logo {
    width: 2rem;
    height: 2rem;
    object-fit: contain;
    display: block;
  }
  .fej__nev {
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .fej__nev em {
    font-style: normal;
    font-weight: 400;
    color: var(--c-steel);
  }

  .nav-fej {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-elem {
    position: relative;
  }

  .nav-gomb {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--f-display);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--c-ink);
    background: none;
    border: none;
    border-radius: var(--r);
    padding: 0.45rem 0.7rem;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .nav-gomb:hover,
  .nav-gomb[aria-expanded='true'] {
    color: var(--c-brand);
    background: var(--c-brand-wash);
  }
  .nav-nyil {
    transition: transform 0.2s;
    flex-shrink: 0;
  }
  .nav-gomb[aria-expanded='true'] .nav-nyil {
    transform: rotate(180deg);
  }

  .nav-panel[hidden] { display: none; }
  .nav-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    left: 0;
    min-width: 16rem;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--r);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.10);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 20;
  }
  /* A jobb szélen álló menüpontok panele jobbra zár, hogy ne lógjon ki. */
  .nav-elem:nth-last-child(-n + 3) .nav-panel {
    left: auto;
    right: 0;
  }
  .nav-panel a {
    font-family: var(--f-body);
    font-size: 0.92rem;
    color: var(--c-ink);
    text-decoration: none;
    padding: 0.65rem 1rem;
    border-left: 3px solid transparent;
    transition: background 0.12s, color 0.12s, border-color 0.12s;
    white-space: nowrap;
  }
  .nav-panel a + a {
    border-top: 1px solid var(--c-line);
  }
  .nav-panel a:hover,
  .nav-panel a[aria-current='page'] {
    background: var(--c-brand-wash);
    color: var(--c-brand);
    border-left-color: var(--c-brand);
  }

  /* --- hamburger gomb --- */

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    margin-right: -0.5rem;
    background: none;
    border: none;
    border-radius: var(--r);
    cursor: pointer;
    flex-shrink: 0;
  }
  .burger__vonal {
    display: block;
    width: 1.35rem;
    height: 2px;
    margin-inline: auto;
    border-radius: 2px;
    background: var(--c-ink);
    transition: transform 0.2s ease, opacity 0.15s ease;
  }
  .fej[data-menu='nyitva'] .burger__vonal:nth-child(1) {
    transform: translateY(0.5rem) rotate(45deg);
  }
  .fej[data-menu='nyitva'] .burger__vonal:nth-child(2) {
    opacity: 0;
  }
  .fej[data-menu='nyitva'] .burger__vonal:nth-child(3) {
    transform: translateY(-0.5rem) rotate(-45deg);
  }

  /* --- köztes sáv: a menü még kifér, csak szűkebben --- */

  @media (min-width: 62.01rem) and (max-width: 78rem) {
    .nav-fej {
