<form class="urlap" id="kapcsolat-urlap" novalidate>
  <label class="field">
    <span>Név</span>
    <input name="nev" type="text" required autocomplete="name" />
  </label>
  <label class="field">
    <span>Cég</span>
    <input name="ceg" type="text" autocomplete="organization" />
  </label>
  <label class="field">
    <span>E-mail</span>
    <input name="email" type="email" required autocomplete="email" />
  </label>
  <label class="field">
    <span>Telefon</span>
    <input name="telefon" type="tel" autocomplete="tel" />
  </label>
  <label class="field">
    <span>Miben segíthetünk?</span>
    <textarea name="uzenet" rows="5" required></textarea>
  </label>

  <!-- mézesbödön: ember nem tölti ki -->
  <label class="hp" aria-hidden="true">
    Ne töltsd ki: <input name="ceges_fax" tabindex="-1" autocomplete="off" />
  </label>

  <button class="btn" type="submit">Üzenet küldése</button>
  <p class="formnote" role="status" aria-live="polite"></p>
</form>

<script>
  const urlap = document.getElementById('kapcsolat-urlap') as HTMLFormElement | null;
  if (urlap) {
    const jelzes = urlap.querySelector('.formnote') as HTMLParagraphElement;
    const gomb = urlap.querySelector('button[type="submit"]') as HTMLButtonElement;

    urlap.addEventListener('submit', async (e) => {
      e.preventDefault();
      const adat = Object.fromEntries(new FormData(urlap).entries());

      if (adat.ceges_fax) return; // bot
      if (!urlap.checkValidity()) {
        jelzes.dataset.state = 'err';
        jelzes.textContent = 'Hiányzik a név, az e-mail vagy az üzenet.';
        urlap.reportValidity();
        return;
      }

      gomb.disabled = true;
      jelzes.dataset.state = '';
      jelzes.textContent = 'Küldés…';

      try {
        // A saját domainünkön futó Pages Function, onnan megy ki a levél az
        // Office 365-ből. Lásd functions/api/kapcsolat.ts
        const valasz = await fetch('/api/kapcsolat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(adat),
        });
        // A végpont a felhasználónak szóló magyar hibaszöveget is visszaadja.
        const test = await valasz.json().catch(() => null);
        if (!valasz.ok || !test?.ok) throw new Error(test?.hiba ?? '');
        // A reset a visszalépéskori újraküldés ellen véd.
        urlap.reset();
        jelzes.dataset.state = 'ok';
        jelzes.textContent = 'Megkaptuk, átirányítjuk…';
        // A köszönőoldal ebből tudja, hogy valódi beküldés történt, és csak
        // ekkor számol konverziót. Lásd src/pages/kapcsolat/koszonjuk.astro
        try {
          sessionStorage.setItem('triox-ajanlatkeres', '1');
        } catch (e) {
          // privát mód: az oldalletöltés így is megmarad a statisztikában
        }
        window.location.assign('/kapcsolat/koszonjuk/');
        return;
      } catch (err) {
        const reszlet = err instanceof Error && err.message ? err.message : '';
        jelzes.dataset.state = 'err';
        jelzes.textContent = reszlet
          ? `${reszlet} Ha nem oldódik meg, írjon ide: info@triox.hu`
          : 'A küldés nem sikerült. Írjon közvetlenül: info@triox.hu';
      } finally {
        gomb.disabled = false;
      }
    });
  }
</script>

<style>
  .urlap {
    max-width: 34rem;
  }
</style>
