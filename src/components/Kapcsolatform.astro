---
const webhook = import.meta.env.PUBLIC_N8N_WEBHOOK ?? '';
---

<form class="urlap" id="kapcsolat-urlap" data-webhook={webhook} novalidate>
  <label class="field">
    <span>Név</span>
    <input name="nev" type="text" required autocomplete="name" />
  </label>
  <label class="field">
    <span>Cég</span>
    <input name="ceg" type="text" autocomplete="organization" />
  </label>
  <label class="field">
    <span>E-mail</span>
    <input name="email" type="email" required autocomplete="email" />
  </label>
  <label class="field">
    <span>Telefon</span>
    <input name="telefon" type="tel" autocomplete="tel" />
  </label>
  <label class="field">
    <span>Miben segíthetünk?</span>
    <textarea name="uzenet" rows="5" required></textarea>
  </label>

  <!-- mézesbödön: ember nem tölti ki -->
  <label class="hp" aria-hidden="true">
    Ne töltsd ki: <input name="ceges_fax" tabindex="-1" autocomplete="off" />
  </label>

  <button class="btn" type="submit">Üzenet küldése</button>
  <p class="formnote" role="status" aria-live="polite"></p>
</form>

<script>
  const urlap = document.getElementById('kapcsolat-urlap') as HTMLFormElement | null;
  if (urlap) {
    const jelzes = urlap.querySelector('.formnote') as HTMLParagraphElement;
    const gomb = urlap.querySelector('button[type="submit"]') as HTMLButtonElement;

    urlap.addEventListener('submit', async (e) => {
      e.preventDefault();
      const adat = Object.fromEntries(new FormData(urlap).entries());

      if (adat.ceges_fax) return; // bot
      if (!urlap.checkValidity()) {
        jelzes.dataset.state = 'err';
        jelzes.textContent = 'Hiányzik a név, az e-mail vagy az üzenet.';
        urlap.reportValidity();
        return;
      }

      const cel = urlap.dataset.webhook;
      if (!cel) {
        jelzes.dataset.state = 'err';
        jelzes.textContent = 'Az űrlap még nincs bekötve. Írj a info@triox.hu címre.';
        return;
      }

      gomb.disabled = true;
      jelzes.dataset.state = '';
      jelzes.textContent = 'Küldés…';

      try {
        const valasz = await fetch(cel, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...adat, forras: 'triox.hu', ido: new Date().toISOString() }),
        });
        if (!valasz.ok) throw new Error(String(valasz.status));
        urlap.reset();
        jelzes.dataset.state = 'ok';
        jelzes.textContent = 'Megkaptuk. Munkanapon belül válaszolunk.';
      } catch {
        jelzes.dataset.state = 'err';
        jelzes.textContent = 'A küldés nem sikerült. Írj közvetlenül: info@triox.hu';
      } finally {
        gomb.disabled = false;
      }
    });
  }
</script>

<style>
  .urlap {
    max-width: 34rem;
  }
</style>
