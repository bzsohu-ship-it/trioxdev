---
interface Props {
  href?: string;
  color?: string;
  speed?: string;
  thickness?: number;
}

const {
  href,
  color = '#5B82E0',
  speed = '5s',
  thickness = 3,
} = Astro.props;

const gradient = `radial-gradient(circle, ${color}, transparent 10%)`;
const padding = `${thickness}px 0`;
---

{href ? (
  <a href={href} class="star-border-container triox-cta" style={`padding: ${padding}`}>
    <div class="border-gradient-bottom" style={`background: ${gradient}; animation-duration: ${speed}`}></div>
    <div class="border-gradient-top" style={`background: ${gradient}; animation-duration: ${speed}`}></div>
    <div class="inner-content"><slot /></div>
  </a>
) : (
  <button class="star-border-container triox-cta" style={`padding: ${padding}`}>
    <div class="border-gradient-bottom" style={`background: ${gradient}; animation-duration: ${speed}`}></div>
    <div class="border-gradient-top" style={`background: ${gradient}; animation-duration: ${speed}`}></div>
    <div class="inner-content"><slot /></div>
  </button>
)}

<style is:global>
  .star-border-container {
    display: inline-block;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
  }

  .border-gradient-bottom {
    position: absolute;
    width: 300%;
    height: 50%;
    opacity: 0.7;
    bottom: -12px;
    right: -250%;
    border-radius: 50%;
    animation: star-movement-bottom linear infinite alternate;
    z-index: 0;
  }

  .border-gradient-top {
    position: absolute;
    opacity: 0.7;
    width: 300%;
    height: 50%;
    top: -12px;
    left: -250%;
    border-radius: 50%;
    animation: star-movement-top linear infinite alternate;
    z-index: 0;
  }

  .triox-cta .inner-content {
    position: relative;
    background: #0d1b3d;
    border: 1px solid #3358A7;
    color: #ffffff;
    font-family: 'Montserrat Variable', 'Montserrat', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    padding: 0.8rem 1.6rem;
    border-radius: 12px;
    z-index: 1;
    transition: background 0.25s ease, transform 0.15s ease;
    white-space: nowrap;
  }

  .triox-cta:hover .inner-content {
    background: #14265a;
  }

  .triox-cta:active .inner-content {
    transform: translateY(1px);
  }

  @keyframes star-movement-bottom {
    0%   { transform: translate(0%, 0%);    opacity: 1; }
    100% { transform: translate(-100%, 0%); opacity: 0; }
  }

  @keyframes star-movement-top {
    0%   { transform: translate(0%, 0%);   opacity: 1; }
    100% { transform: translate(100%, 0%); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .border-gradient-top,
    .border-gradient-bottom {
      animation: none;
      opacity: 0.5;
    }
  }
</style>
