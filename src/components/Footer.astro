---
import { nyelvAz } from '../i18n/utak';

const ev = new Date().getFullYear();

const szoveg = {
  hu: {
    szlogen: 'Tudjuk hogyan segíthetünk önnek',
    nav: 'Lábléc',
    linkek: [
      { href: '/szolgaltatasok/', cim: 'Szolgáltatások' },
      { href: '/blog/', cim: 'Blog' },
      { href: '/tamogatas/', cim: 'Támogatás' },
      { href: '/partnerek/', cim: 'Partnerek' },
      { href: '/adatvedelmi-nyilatkozat/', cim: 'Adatvédelem' },
      { href: 'https://rd.triox.hu', cim: 'Távsegítség' },
    ],
    jog: 'Minden jog fenntartva.',
  },
  en: {
    szlogen: 'We know how to help you',
    nav: 'Footer',
    linkek: [
      { href: '/en/services/', cim: 'Services' },
      { href: '/en/blog/', cim: 'Blog' },
      { href: '/en/support/', cim: 'Support' },
      { href: '/en/partners/', cim: 'Partners' },
      // Angol adatvédelmi nyilatkozat nincs — a magyarra mutat, mint a magyar lábléc.
      { href: '/adatvedelmi-nyilatkozat/', cim: 'Privacy' },
      { href: 'https://rd.triox.hu', cim: 'Remote assistance' },
    ],
    jog: 'All rights reserved.',
  },
}[nyelvAz(Astro.url.pathname)];
---

<footer class="lab">
  <div class="wrap lab__in">
    <div>
      <div class="lab__marka">
        <img class="lab__jel" src="/logo.svg" alt="" aria-hidden="true" width="44" height="44" />
        <p class="lab__szoveg">
          <span class="lab__nev">triox <em>informatika</em></span>
          <span class="lab__szlogen">{szoveg.szlogen}</span>
        </p>
      </div>
    </div>
    <nav aria-label={szoveg.nav}>
      {szoveg.linkek.map((l) => <a href={l.href}>{l.cim}</a>)}
    </nav>
  </div>
  <div class="wrap lab__jog">
    <p>© {ev} Triox Informatika Kft. {szoveg.jog} · <a href="mailto:info@triox.hu">info@triox.hu</a></p>
  </div>
</footer>

<style>
  .lab {
    border-top: 1px solid var(--c-line);
    background: var(--c-mist);
    padding-block: 3rem 1.5rem;
    margin-top: 4rem;
  }
  .lab__in {
    display: flex;
    /* A márkablokk alacsonyabb, mint a menü — középre igazítva kiegyensúlyozott
       marad a lábléc. Alapértelmezett stretch mellett felülre tapadna. */
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .lab__marka {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
  }
  .lab__jel {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
  }
  /* Cégnév felül, alatta a kisebb szlogen — balra zárva. */
  .lab__szoveg {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin: 0;
  }
  /* Ugyanaz a szedés, mint a fejlécben: félkövér „triox", normál „informatika". */
  .lab__nev {
    font-family: var(--f-display);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.25;
    white-space: nowrap;
  }
  .lab__nev em {
    font-style: normal;
    font-weight: 400;
    color: var(--c-steel);
  }
  .lab__szlogen {
    font-family: var(--f-display);
    font-size: 0.88rem;
    color: var(--c-steel);
    line-height: 1.35;
  }
  .lab nav {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.4rem 2rem;
  }
  .lab nav a {
    font-size: 0.92rem;
    text-decoration: none;
    color: var(--c-ink);
  }
  .lab nav a:hover {
    color: var(--c-brand);
    text-decoration: underline;
  }
  .lab__jog {
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--c-line);
    color: var(--c-steel);
    font-size: 0.82rem;
  }
  .lab__jog p {
    margin: 0;
  }
  @media (max-width: 34rem) {
    .lab {
      padding-block: 2.25rem 1.25rem;
      margin-top: 3rem;
    }
    .lab__in {
      gap: 1.5rem;
    }
    .lab nav {
      gap: 0.55rem 1.25rem;
    }
    .lab__jog {
      margin-top: 1.75rem;
    }
  }
</style>
