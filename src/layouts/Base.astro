---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { nyelvAz, parja, vanParja } from '../i18n/utak';

interface Props {
  cim: string;
  leiras: string;
}

const { cim, leiras } = Astro.props;
const ut = Astro.url.pathname;
const kanonikus = new URL(ut, Astro.site);
// A megosztóképek abszolút URL-t igényelnek, különben a Facebook/LinkedIn nem tölti be.
const ogKep = new URL('/og-image-1200x630-vilagos.png', Astro.site);
const twitterKep = new URL('/twitter-card-1200x675-vilagos.png', Astro.site);

const nyelv = nyelvAz(ut);
// hreflang csak valódi párnál: a 404 vagy egy pár nélküli oldal ne hivatkozzon
// a másik nyelv kezdőlapjára mint saját fordítására.
const parUrl = vanParja(ut) ? new URL(parja(ut), Astro.site) : undefined;
const huUrl = nyelv === 'hu' ? kanonikus : parUrl;
const enUrl = nyelv === 'en' ? kanonikus : parUrl;

const nyelvi = {
  hu: {
    locale: 'hu_HU',
    masikLocale: 'en_US',
    kepAlt: 'Triox Informatika — Tudjuk hogyan segíthetünk önnek',
    szlogen: 'Tudjuk hogyan segíthetünk önnek',
    szolgaltatasok: ['IT rendszerfelügyelet', 'Felhő szolgáltatások', 'Adatmentés', 'Hoszting'],
  },
  en: {
    locale: 'en_US',
    masikLocale: 'hu_HU',
    kepAlt: 'Triox Informatika — We know how to help you',
    szlogen: 'We know how to help you',
    szolgaltatasok: ['IT systems management', 'Cloud services', 'Data backup', 'Hosting'],
  },
}[nyelv];
---

<!doctype html>
<html lang={nyelv}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{cim} — Triox Informatika Kft.</title>
    <meta name="description" content={leiras} />
    <link rel="canonical" href={kanonikus} />
    {huUrl && enUrl && (
      <>
        <link rel="alternate" hreflang="hu" href={huUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={huUrl} />
      </>
    )}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="theme-color" content="#0007ff" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={nyelvi.locale} />
    {parUrl && <meta property="og:locale:alternate" content={nyelvi.masikLocale} />}
    <meta property="og:site_name" content="Triox Informatika Kft." />
    <meta property="og:title" content={cim} />
    <meta property="og:description" content={leiras} />
    <meta property="og:url" content={kanonikus} />
    <meta property="og:image" content={ogKep} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={nyelvi.kepAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={twitterKep} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfessionalService',
      name: 'Triox Informatika Kft.',
      url: 'https://triox.hu',
      email: 'info@triox.hu',
      areaServed: 'HU',
      slogan: nyelvi.szlogen,
      serviceType: nyelvi.szolgaltatasok,
    })} />
  </head>
  <body>
    <Header />
    <main id="tartalom">
      <slot />
    </main>
    <Footer />
  </body>
</html>
