---
import Base from '../layouts/Base.astro';

/**
 * Esettanulmányok.
 *
 * FONTOS a szövegezésre: a négy környezet ténye a Rólunk oldalról származik
 * (`src/pages/rolunk.astro`, „Akikkel dolgozunk"). Minden technikai állítás,
 * amivel itt kibontjuk őket, egy máshol már kiadott, megerősített tételre
 * megy vissza — a szolgáltatásoldalak platform-katalógusára, a /technologia/
 * kártyáira, a /biztonsag/ rétegeire vagy a /rolunk/ számaira.
 *
 * Amit ezen az oldalon SOHA nem írunk le, amíg Zsolt meg nem erősíti:
 * ügyfélnév, ágazati alszegmens, iparági utalás, ami beazonosíthatóvá tesz,
 * továbbá bármilyen mért szám (adatmennyiség, VM-darabszám, felhasználószám,
 * migrációs időtartam, állásidő, megtakarítás, elért rendelkezésre állás).
 * A nyitott kérdések: `docs/esettanulmanyok-megerositendo.md` (nincs a buildben).
 *
 * A csillag (*) mind a négy környezetnév mellett ott áll, és a lap alján lévő
 * `#nevekrol` lábjegyzetre mutat. Szándékosan apró: a diszkréció tény, nem
 * üzenet — nem ez az oldal mondanivalója.
 */

interface Eset {
  /** Rövid kategória-név. Ugyanaz, mint az áttekintő táblázat sorában. */
  cimke: string;
  /** A környezet megnevezése — ez kap csillagot. */
  nev: string;
  cim: string;
  /** Első bekezdés a kiinduló helyzet, a többi a megoldás. */
  allitas: string[];
  kulcs: string;
  /** Melyik beágyazott ábra tartozik hozzá. */
