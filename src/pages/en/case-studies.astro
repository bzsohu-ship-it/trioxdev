---
import Base from '../../layouts/Base.astro';

/**
 * Esettanulmányok.
 *
 * FONTOS a szövegezésre: a négy környezet ténye a Rólunk oldalról származik
 * (`src/pages/rolunk.astro`, „Akikkel dolgozunk"). Minden technikai állítás,
 * amivel itt kibontjuk őket, egy máshol már kiadott, megerősített tételre
 * megy vissza — a szolgáltatásoldalak platform-katalógusára, a /technologia/
 * kártyáira, a /biztonsag/ rétegeire vagy a /rolunk/ számaira.
 *
 * Amit ezen az oldalon SOHA nem írunk le, amíg Zsolt meg nem erősíti:
 * ügyfélnév, ágazati alszegmens, iparági utalás, ami beazonosíthatóvá tesz,
 * továbbá bármilyen mért szám (adatmennyiség, VM-darabszám, felhasználószám,
 * migrációs időtartam, állásidő, megtakarítás, elért rendelkezésre állás).
 * A nyitott kérdések: `docs/esettanulmanyok-megerositendo.md` (nincs a buildben).
 *
 * A csillag (*) mind a négy környezetnév mellett ott áll, és a lap alján lévő
 * `#nevekrol` lábjegyzetre mutat. Szándékosan apró: a diszkréció tény, nem
 * üzenet — nem ez az oldal mondanivalója.
 */

interface Eset {
  /** Rövid kategória-név. Ugyanaz, mint az áttekintő táblázat sorában. */
  cimke: string;
  /** A környezet megnevezése — ez kap csillagot. */
  nev: string;
  cim: string;
  /** Első bekezdés a kiinduló helyzet, a többi a megoldás. */
  allitas: string[];
  kulcs: string;
  /** Melyik beágyazott ábra tartozik hozzá. */
  abra?: 'migracio' | 'izolacio' | 'ketszintu';
  reszletek: { cimke?: string; szoveg: string }[];
  hivatkozasok: { szoveg: string; url: string }[];
}

const esetek: Eset[] = [
  {
    cimke: 'Full infrastructure and migration',
    nev: 'Media service provider with nationwide coverage',
    cim: 'We replaced the infrastructure under a live nationwide service',
    allitas: [
      'The job was to build and operate the entire internal network, web and data infrastructure—but not from a blank slate. The system was running, with nationwide coverage, and it had to keep running during the move. For a provider like this, downtime is not an operational inconvenience: it is a service outage.',
      'So the new environment was not built in place of the old one, but alongside it. It was fully up and running before anything was moved onto it; the live cutover came only after a test migration, in an agreed time window, with a rollback plan. The workload is resource- and storage-intensive, so the backbone here, too, is the redundant 2×10 Gbps build—losing one uplink or one switch does not mean losing the service.',
      'The project did not end with the cutover: we have operated the environment ever since, including monitoring, backup and documentation.',
    ],
    kulcs: 'The migration succeeded if viewers never even noticed it happened.',
    abra: 'migracio',
    reszletek: [
      { cimke: 'Network', szoveg: 'internal network infrastructure build-out, VLAN-based segmentation, dedicated gateway per client' },
      { cimke: 'Backbone', szoveg: 'redundant 2×10 Gbps—the bottleneck is rarely the CPU, far more often the network or the storage' },
      { cimke: 'Resources', szoveg: 'CPU, memory and storage allocation sized to the workload, not a prepackaged bundle' },
      { cimke: 'Web and data layer', szoveg: 'the public (web) and the internal (database, application) layers on separate network levels' },
      { cimke: 'Migration', szoveg: 'parallel build, test migration, live cutover in an agreed time window, with a rollback plan' },
      { cimke: 'Operations', szoveg: 'continuous monitoring, backup to multiple independent targets, off-site replica for critical workloads' },
    ],
    hivatkozasok: [
      { szoveg: 'Why the server is not the bottleneck', url: '/en/technology/' },
      { szoveg: 'DCaaS—the entire environment, outsourced', url: '/en/services/dcaas/' },
    ],
  },
  {
    cimke: 'Isolated environment',
    nev: 'Biotechnology research lab',
    cim: 'An environment with no route leading to it from the internet',
    allitas: [
      'Research workloads handling large volumes of data, on data whose nature does not allow internet access. In this case the question is not whether the firewall rule is strong enough, but whether there is any rule at all that could be misconfigured.',
      'The solution is a fully isolated infrastructure: a private subnet on its own virtual or physical switch, with no published services. There is no route into the environment from the internet—not because it is blocked, but because there is nothing to block. Access goes through a dedicated VPN endpoint, and the management interface sits on the out-of-band management network, which is not reachable from outside either.',
      'Today this is not a plan for us but working practice: this is how the environments of our clients who handle sensitive data run.',
    ],
    kulcs: 'Here isolation is not a setting but topology. A setting can be misconfigured; topology cannot.',
    abra: 'izolacio',
    reszletek: [
      { cimke: 'Isolation', szoveg: 'own virtual or physical switch, private subnet, an environment not reachable from the internet' },
      { cimke: 'Access', szoveg: 'dedicated VPN endpoint per client—IPsec, WireGuard, OpenVPN or SSTP' },
      { cimke: 'Resources', szoveg: 'allocation sized for workloads with large data volumes and high resource demands' },
      { cimke: 'Backup', szoveg: 'the backup targets are also part of the closed environment, independent of each other' },
      { cimke: 'Management', szoveg: 'dedicated out-of-band management network—no exposed management interface' },
      { cimke: 'Hardware level', szoveg: 'iDRAC and iLO: the server can be managed even if the operating system does not boot' },
    ],
    hivatkozasok: [
      { szoveg: 'The segmentation and isolation layer', url: '/en/security/' },
      { szoveg: 'Client isolation in practice', url: '/en/technology/' },
    ],
  },
  {
    cimke: 'Segmented application stack',
    nev: 'Financial services provider with a nationwide branch network',
    cim: 'Two tiers, so there is no path from the public side to the data',
    allitas: [
      'At a financial services provider, the most exposed point and the most sensitive point are the same system: the public interface has to be reachable from outside, while the data has to be as protected as possible. On a flat network, the two are one hop apart.',
      'That is why the stack has two tiers: the database and application layer is sharply separated from the public services. In front of the environment stands a dedicated gateway per client, with its own firewall, NAT and VPN rules, and its own public IPv4 address from our address range—so the IP reputation of the service and of its email does not depend on what another client does.',
      'The practical consequence is simple: if a component of the public layer falls, the loss stays limited to that one component. It does not open up the database.',
    ],
    kulcs: 'The question is not whether an attacker ever gets onto the first machine. It is how far they get from there.',
    abra: 'ketszintu',
    reszletek: [
      { cimke: 'Two-tier split', szoveg: 'separate internal (database, application) and public (web, mail) network layers' },
      { cimke: 'Gateway', szoveg: 'dedicated firewall, NAT and VPN endpoint per client, with its own rule set' },
      { cimke: 'Public IP', szoveg: "dedicated public IPv4 address from our own address range, assigned in the client's name" },
      { cimke: 'Segment isolation', szoveg: "no crossover between segments—none of this is visible from another client's environment" },
      { cimke: 'Certificates', szoveg: 'management of public and internal TLS certificates, with expiry monitoring' },
      { cimke: 'Backup', szoveg: 'application-aware, database-consistent backup—not just a file-level copy' },
    ],
    hivatkozasok: [
      { szoveg: 'The seven layers of protection—and where an attack stops', url: '/en/security/' },
      { szoveg: 'SaaS—application hosting in a managed environment', url: '/en/services/saas/' },
    ],
  },
  {
    cimke: 'Outsourced operations',
    nev: 'Commercial and service companies',
    cim: 'The system worked. It was just that only one person knew how',
    allitas: [
      "This fourth case is not a single large project but several companies in the same situation: a web, file and directory environment that has been running for years, but undocumented. The knowledge is in one person's head, nobody knows for sure whether the backup can be restored, and nobody has known for a long time who has access to what.",
      'In these cases a takeover does not start with a move but with an assessment: what is running, what it runs on, what is missing. Then comes documentation, the rollout of monitoring, and then stabilization—fixing the gaps uncovered: missing updates, backup gaps, outdated permissions. Only after that does the system become a continuously operated environment, with regular reporting.',
      'Where the hardware has to stay on-site—because a production control system, a measuring instrument or a data-handling rule ties it there—we do not move it. We bring the same procedures to the site.',
    ],
    kulcs: 'A key-person dependency does not come to light while the colleague is at work. It comes to light when they are not.',
    reszletek: [
      { cimke: 'Directory', szoveg: 'Active Directory domain, Group Policy, redundant domain controllers' },
      { cimke: 'File services', szoveg: 'file server environment, with the permission structure put in order' },
      { cimke: 'Web environment', szoveg: 'web and mail servers on the public layer, TLS certificates with expiry monitoring' },
      { cimke: 'Takeover', szoveg: 'status assessment and risk list, then a documented handover—coordinated with the departing colleague if needed' },
      { cimke: 'Stabilization', szoveg: 'in the first weeks, fixing the gaps uncovered: updates, backup gaps, permissions' },
      { cimke: 'Operations', szoveg: 'monitoring, helpdesk, patch management, daily backup checks, regular reporting' },
    ],
    hivatkozasok: [
      { szoveg: 'Managed IT operations—the operator is included', url: '/en/services/managed-it-operations/' },
      { szoveg: 'If the server has to stay on-site', url: '/en/services/on-premises-and-hybrid-it/' },
    ],
  },
];

/**
 * Hero alatti gyorsnézet. Egyik szám sem új: mind a Rólunk oldal
 * „Számokban" táblázatából jön.
 */
const gyorsnezet = [
  { ertek: '4 environments', szoveg: 'from the media provider to the isolated research lab' },
  { ertek: '20+ years', szoveg: 'of enterprise IT operations experience behind them' },
  { ertek: '1 client = 1 network', szoveg: 'all four environments run on a dedicated segment' },
  { ertek: '2 sites', szoveg: 'data centers in Budapest, independent of each other' },
];

/** Áttekintő táblázat. A sorrend azonos az esetkártyákéval. */
const attekintes = [
  {
    kornyezet: 'Media service provider with nationwide coverage',
    kiindulas: 'A live nationwide service in an existing environment that had to be taken over and migrated.',
    feladat: 'Building the entire internal network, web and data infrastructure, with migration and ongoing operations.',
    kulcselem: 'Parallel build and test migration, on a redundant 2×10 Gbps backbone.',
  },
  {
    kornyezet: 'Biotechnology research lab',
    kiindulas: 'Research workloads with large data volumes, on data that must not be exposed to the internet.',
    feladat: 'Fully isolated IT infrastructure, not reachable from the internet.',
    kulcselem: 'Private subnet on its own switch, dedicated VPN endpoint, out-of-band management.',
  },
  {
    kornyezet: 'Financial services provider with a nationwide branch network',
    kiindulas: 'An outward-facing public interface and the most sensitive data in the same system.',
    feladat: 'A two-tier, segmented application stack.',
    kulcselem: 'The database and application layer sharply separated from the public services.',
  },
  {
    kornyezet: 'Commercial and service companies',
    kiindulas: "A system running for years, but undocumented, resting on a single colleague's knowledge.",
    feladat: 'Outsourced operation of web, file and directory environments.',
    kulcselem: 'Takeover with documentation, monitoring, stabilization, daily backup checks.',
  },
];

/**
 * Mit kap papíron. Mindegyik tétel egy máshol már leírt szolgáltatási
 * lépéshez tartozik — a forrás a `dcaas.md` 8. pontja, a
 * `menedzselt-it-uzemeltetes.md` „Hogyan kezdünk neki?" fejezete és az
 * `audit-restore-validation.md`.
 */
const dokumentumok = [
  {
    dokumentum: 'Status assessment and risk list',
    tartalom: 'Servers, network, workstations, licenses, backup and the risks uncovered—specific, not estimated.',
    mikor: 'Before the decision. The assessment is not a commitment.',
  },
  {
    dokumentum: 'Target architecture, RPO and RTO',
    tartalom: 'Defined per system: how much downtime and how much data loss is acceptable.',
    mikor: 'Before the quote.',
  },
  {
    dokumentum: 'Migration plan and rollback plan',
    tartalom: 'Schedule, sequence, test migration—and also what happens if we have to roll back.',
    mikor: 'Before the cutover. A critical system is never moved live without preparation.',
  },
  {
    dokumentum: 'Service level agreement (SLA)',
    tartalom: 'Availability, response time, maintenance windows, backup and retention rules—in writing.',
    mikor: 'When the service starts.',
  },
  {
    dokumentum: 'System documentation',
    tartalom: "A transferable description of the running environment. This is the point where the knowledge leaves a single person's head.",
    mikor: 'At takeover, then continuously, with change tracking.',
  },
  {
    dokumentum: 'Restore report',
    tartalom: 'Whether the system really starts from the backup—in an isolated test environment, with a rating.',
    mikor: 'After the restore test, as a standalone service.',
  },
  {
    dokumentum: 'Operations report',
    tartalom: 'What happened in your environment, and what to prepare for in the coming period.',
    mikor: 'During operations, on a schedule.',
  },
];

/** „Ismerős a helyzet?" — a mondat, amit a felmérésen hallunk, és hova vezet. */
const helyzetek = [
  {
    tapasztalat: '“It works, but only one colleague knows how.”',
    jelentes: 'Key-person dependency. The knowledge is not documented, so it cannot be handed over either.',
    hova: { szoveg: 'Case 04 · Managed operations', url: '/en/services/managed-it-operations/' },
  },
  {
    tapasztalat: "“We'd like to move, but the service can't stop.”",
    jelentes: 'Migration risk. The destination is not the hard part—the way there is.',
    hova: { szoveg: 'Case 01 · DCaaS', url: '/en/services/dcaas/' },
  },
  {
    tapasztalat: "“This data can't be on the internet.”",
    jelentes: 'Isolation requirement. A rule is not enough here—it takes topology.',
    hova: { szoveg: 'Case 02 · Security', url: '/en/security/' },
  },
  {
    tapasztalat: '“Our web interface faces outward, and the database sits right behind it.”',
    jelentes: 'Missing segmentation. A compromised web server can see the data.',
    hova: { szoveg: 'Case 03 · Security', url: '/en/security/' },
  },
  {
    tapasztalat: "“We have backups, but we've never tried restoring them.”",
    jelentes: 'Unproven recoverability. The problem comes to light at restore time.',
    hova: { szoveg: 'Audit Restore Validation', url: '/en/services/audit-restore-validation/' },
  },
  {
    tapasztalat: "“We don't know exactly who has access to what.”",
    jelentes: 'An unmaintained permission structure. Losing one account costs a lot.',
    hova: { szoveg: 'AI in the office: what does it actually see?', url: '/en/blog/ai-in-the-office-permissions/' },
  },
  {
    tapasztalat: '“The server sits in a cabinet in the office.”',
    jelentes: 'Physical risk: fire, water damage, heat, power outage—and each of them takes out production and backup at the same time.',
    hova: { szoveg: 'On-premises and hybrid operations', url: '/en/services/on-premises-and-hybrid-it/' },
  },
];

const tartozkodas = [
  {
    cim: "We don't publish client names",
    szoveg:
      "For an IT operations provider, who its clients are is information in itself—about where a given company's infrastructure is, and who holds the keys to it. We don't put that on a website. If you need a reference for your decision, ask during the assessment: we will see what we can share with the consent of the client concerned.",
  },
  {
    cim: "We don't publish numbers we haven't measured",
    szoveg:
      'There are no hours saved, percentage speedups or achieved availability figures on this page. Every number that does appear here—20+ years, two data center sites, 2×10 Gbps—can also be found on the other pages of this website. Committed availability and response times belong in the service agreement, not in a case study.',
  },
  {
    cim: 'A case study is not a price list',
    szoveg:
      "The solution described was built for that specific environment. We don't sell templates: we tailor both the infrastructure and the operations service to the specific needs, so what worked at a similar company does not, by itself, determine your quote.",
  },
  {
    cim: "We don't claim every project went smoothly",
    szoveg:
      'In a migration, something always turns out differently than planned. That is exactly why it comes with a rollback plan, and why we never try anything in production first. The difference is not that there are no surprises, but that there is an answer to them.',
  },
];
---

<Base
  cim="Case studies"
  leiras="Four completed environments: full infrastructure with migration for a nationwide media service provider, an isolated research lab, a two-tier segmented financial stack, and outsourced web, file and directory operations."
>
  <section class="band">
    <div class="wrap">
      <div class="hero">
        <p class="eyebrow">Case studies</p>
        <h1>Four environments, four very different tasks—on the same foundation</h1>
        <p class="lead">
          The four environments below are real, completed projects. For each one, we describe the
          starting situation, what had to be solved, and which technical decision determined the
          outcome. We
          <a class="csillag-hiv" href="#nevekrol">do not publish</a> client names—the task we solved is
          the main subject.
        </p>
      </div>

      <ul class="gyorsnezet">
        {gyorsnezet.map((g) => (
          <li>
            <span class="gyorsnezet__ertek">{g.ertek}</span>
            <span class="gyorsnezet__szoveg">{g.szoveg}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap">
      <h2 class="szekcio__cim">The four environments at a glance</h2>
      <p class="szekcio__lead">
        A media service provider, a research lab, a financial services provider and several commercial
        companies do not ask for the same thing. The table below shows where the tasks differ—the
        detailed description of each follows further down.
      </p>

      <div class="tabla-doboz">
        <table class="tabla">
          <thead>
            <tr>
              <th scope="col">
                Environment<sup class="csillag"><a href="#nevekrol" aria-label="Note on client names">*</a></sup>
              </th>
              <th scope="col">Starting situation</th>
              <th scope="col">The task solved</th>
              <th scope="col">The decisive technical element</th>
            </tr>
          </thead>
          <tbody>
            {attekintes.map((a, i) => (
              <tr>
                <th scope="row">
                  <span class="tabla__idx">{String(i + 1).padStart(2, '0')}</span>
                  {a.kornyezet}
                </th>
                <td>{a.kiindulas}</td>
                <td>{a.feladat}</td>
                <td>{a.kulcselem}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="szekcio__cim">The four environments in detail</h2>
      <p class="szekcio__lead">
        Each case follows the same structure: what the situation was, what we did, and what the key
        point is. The technical details can be expanded, and the links lead to where each solution is
        also described in general terms.
      </p>

      <div class="ekartyak">
        {esetek.map((e, i) => (
          <article class="ekartya">
            <div class="ekartya__fej">
              <span class="ekartya__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="ekartya__cimke">{e.cimke}</span>
            </div>

            <p class="ekartya__nev">
              {e.nev}
              <sup class="csillag"><a href="#nevekrol" aria-label="Note on client names">*</a></sup>
            </p>

            <h3>{e.cim}</h3>

            {e.allitas.map((bek) => <p>{bek}</p>)}

            <p class="ekartya__kulcs">{e.kulcs}</p>

            {e.abra === 'migracio' && (
              <figure class="abra">
                <svg viewBox="0 0 880 350" role="img" aria-labelledby="abra-migracio">
                  <title id="abra-migracio">
                    The phases of the cutover on a timeline. The existing environment stays live
                    from the assessment all the way to the live cutover, while the new environment
                    is built in parallel alongside it. Five phases follow one another, with
                    overlapping stages: an assessment of servers, applications, data and network;
                    target architecture and plan, with RPO and RTO values, scheduling and a rollback
                    plan; a parallel build, during which the new environment is built first; a test
                    migration, because we never try anything in production first; and finally the
                    live cutover in an agreed time window, followed by ongoing operations. The bars
                    show the sequence and the overlap, not the duration of each phase.
                  </title>

                  <text class="abra__mono" x="0" y="14">CUTOVER PHASES—THE OLD SYSTEM KEEPS RUNNING</text>
                  <text class="abra__mono" x="880" y="14" text-anchor="end">TIME→</text>

                  <text class="abra__mono" x="0" y="45">OLD SYSTEM</text>
                  <text class="abra__kicsi" x="0" y="59">stays live, the service does not stop</text>
                  <rect class="abra__sin" x="270" y="34" width="610" height="26" rx="3" />
                  <rect class="abra__mult" x="270" y="34" width="530" height="26" rx="3" />

                  <text class="abra__mono" x="0" y="81">NEW SYSTEM</text>
                  <text class="abra__kicsi" x="0" y="95">built in parallel, not on top of the old</text>
                  <rect class="abra__sin" x="270" y="70" width="610" height="26" rx="3" />
                  <rect class="abra__fazis" x="450" y="70" width="430" height="26" rx="3" />

                  <text class="abra__mono" x="0" y="131">01 · SURVEY</text>
                  <text class="abra__kicsi" x="0" y="145">servers, applications, data, network</text>
                  <rect class="abra__sin" x="270" y="120" width="610" height="26" rx="3" />
                  <rect class="abra__fazis" x="270" y="120" width="120" height="26" rx="3" />

                  <text class="abra__mono" x="0" y="167">02 · TARGET DESIGN</text>
                  <text class="abra__kicsi" x="0" y="181">RPO/RTO, schedule, rollback plan</text>
                  <rect class="abra__sin" x="270" y="156" width="610" height="26" rx="3" />
                  <rect class="abra__fazis" x="360" y="156" width="120" height="26" rx="3" />

                  <text class="abra__mono" x="0" y="203">03 · PARALLEL BUILD</text>
                  <text class="abra__kicsi" x="0" y="217">the new system is built first</text>
                  <rect class="abra__sin" x="270" y="192" width="610" height="26" rx="3" />
                  <rect class="abra__fazis" x="450" y="192" width="210" height="26" rx="3" />

                  <text class="abra__mono" x="0" y="239">04 · TEST MIGRATION</text>
                  <text class="abra__kicsi" x="0" y="253">nothing is tried in production first</text>
                  <rect class="abra__sin" x="270" y="228" width="610" height="26" rx="3" />
                  <rect class="abra__fazis" x="630" y="228" width="140" height="26" rx="3" />

                  <text class="abra__mono" x="0" y="275">05 · LIVE CUTOVER</text>
                  <text class="abra__kicsi" x="0" y="289">in an agreed window, then operations</text>
                  <rect class="abra__sin" x="270" y="264" width="610" height="26" rx="3" />
                  <rect class="abra__zaro" x="740" y="264" width="140" height="26" rx="3" />

                  <text class="abra__mono" x="440" y="320" text-anchor="middle">LIVE CUTOVER IN AN AGREED TIME WINDOW, WITH A ROLLBACK PLAN</text>
                  <text class="abra__mono" x="440" y="340" text-anchor="middle">BARS SHOW ORDER AND OVERLAP, NOT DURATION</text>
                </svg>
              </figure>
            )}

            {e.abra === 'izolacio' && (
              <figure class="abra">
                <svg viewBox="0 0 880 322" role="img" aria-labelledby="abra-izolalt">
                  <title id="abra-izolalt">
                    The five layers of the isolated research environment. No services are published
                    toward the internet: no route leads to the segment, so there is no rule that
                    could be misconfigured. Researcher access goes through a dedicated VPN endpoint
                    per client, using IPsec, WireGuard, OpenVPN or SSTP. The compute and storage
                    layer sits on a private subnet, on its own virtual or physical switch. The backup
                    targets are also part of the closed environment, independent of each other.
                    Management runs on an out-of-band network that is not reachable from the
                    internet.
                  </title>

                  <text class="abra__mono" x="0" y="14">ISOLATED RESEARCH SETUP—WHAT GETS IN, WHAT DOESN'T</text>

                  <rect class="abra__sav" x="0" y="30" width="250" height="48" rx="3" />
                  <text class="abra__mono" x="16" y="59">FROM INTERNET</text>
