              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="jelmagyarazat">
        <li><span aria-hidden="true">●</span> Triox’s responsibility</li>
        <li><span aria-hidden="true">◐</span> Shared, per the contract</li>
