---
import Base from '../../layouts/Base.astro';

/**
 * Biztonsági megközelítés.
 *
 * FONTOS a szövegezésre: ezen az oldalon minden állítás mögött állnia kell egy
 * másik oldalon már kiadott, megerősített tételnek — a szolgáltatásoldalak
 * platform-katalógusának, a /technologia/ kártyáinak vagy a /rolunk/ számainak.
 * Új biztonsági állítás (tanúsítvány, SIEM, EDR-termék, pentest, DDoS-védelem,
 * titkosítási eljárás, rendelkezésre állási vagy reakcióidő-szám) csak akkor
 * kerülhet ki, ha Zsolt megerősítette. A nyitott kérdések:
 * `docs/biztonsag-megerositendo.md` (nincs a buildben).
 *
 * A rétegkártyák sorrendje szándékosan azonos a „védelem rétegei" ábráéval:
 * az olvasó kívülről befelé halad, és a kártya ugyanazt a réteget bontja ki,
 * amit az ábrán az imént látott.
 */

interface Reteg {
  /** Rövid réteg-név. Ugyanaz, mint az ábra bal oldali sávjában. */
  cimke: string;
  cim: string;
  /** Első bekezdés a kockázat, második a válasz. */
  allitas: string[];
  kulcs: string;
  reszletek: { cimke?: string; szoveg: string }[];
  hivatkozas?: { szoveg: string; url: string };
}

const retegek: Reteg[] = [
  {
    cimke: 'Physical layer',
    cim: 'The server is not sitting in an office closet',
    allitas: [
      'A large share of the most expensive data losses do not come from an attack but from a server room that flooded, overheated or was broken into. An office server cabinet is protected by luck, not by security: everything is fine with it until something goes wrong.',
      'The environments we run are housed at two independent data center sites in Budapest, in physically protected data halls with redundant power and data center cooling. The hardware is enterprise-grade: redundant power supplies, ECC memory, RAID-protected storage.',
    ],
    kulcs: 'Fire, water damage and power outages do not start out as security issues. They end up as one.',
    reszletek: [
      { cimke: 'Sites', szoveg: 'two data center sites in Budapest, independent of each other' },
      { cimke: 'Data hall', szoveg: 'physically protected environment, redundant power, data center cooling and temperature monitoring' },
      { cimke: 'Certification', szoveg: 'both sites are in ISO/IEC 27001:2022 certified data centers, in dedicated, locked racks' },
      { cimke: 'Hardware', szoveg: 'enterprise server fleet with redundant power supplies, ECC memory and RAID-protected storage' },
      { cimke: 'Backbone', szoveg: 'redundant 2×10 Gbps—losing one uplink or one switch does not mean a service outage' },
      { cimke: 'For on-site systems', szoveg: 'monitoring of the uninterruptible power supply (UPS), with orderly shutdown during a power outage' },
    ],
    hivatkozas: { szoveg: 'Infrastructure details on the Technology page', url: '/en/technology/' },
  },
  {
    cimke: 'Network edge',
    cim: 'A dedicated gateway per client, not a shared template',
    allitas: [
      'On a shared firewall, other people’s rules sit right next to yours. A port opened for another client, a misconfigured forward or a mail server IP with a damaged reputation becomes your risk too—even if you did everything right.',
      'With us, every client gets its own gateway: the firewall, NAT and port rules belong only to your environment, the VPN endpoint is dedicated, and the public IPv4 address comes from our own address range and is assigned to you by name.',
    ],
    kulcs: 'Having your own public IP also means your email reputation does not depend on what another client does.',
    reszletek: [
      { cimke: 'Gateway', szoveg: 'dedicated firewall, NAT and VPN endpoint per client, with its own rule set' },
      { cimke: 'Public IP', szoveg: 'dedicated public IPv4 address from our own address range' },
      { cimke: 'VPN', szoveg: 'site-to-site and client access—IPsec, WireGuard, OpenVPN, SSTP' },
      { cimke: 'Devices', szoveg: 'MikroTik RouterOS, Cisco, plus Fortinet, pfSense and OPNsense firewalls' },
      { cimke: 'Certificates', szoveg: 'management of public and internal TLS certificates, with expiry monitoring' },
      { szoveg: 'On site: Wi-Fi infrastructure with guest network separation' },
    ],
    hivatkozas: { szoveg: 'Which vendors stand behind the network', url: '/en/partners/' },
  },
  {
    cimke: 'Segmentation',
    cim: 'A breach of the public layer should not reach the database',
    allitas: [
      'In most serious incidents, what matters is not that the attacker got into the first machine but how far they got from there. On a flat network, a compromised web server has a direct line of sight to the file server and the database.',
      'With us, the internal layer (database, application) and the public layer (web, mail) are strictly separated, and client segments are isolated from each other with VLAN-based or physical segmentation. Where the nature of the data requires it, the environment cannot be reached from the internet at all—for our clients who handle sensitive data, this is already working practice, not a plan.',
    ],
    kulcs: 'In an audit, “logically separated” is often not enough. That is why we offer physical segmentation too.',
    reszletek: [
      { cimke: 'Two-tier design', szoveg: 'separate internal (database, application) and public (web, mail) network layers' },
      { cimke: 'Client isolation', szoveg: 'a dedicated segment per client, with VLAN-based or physical segmentation' },
      { cimke: 'Full isolation', szoveg: 'on request, a dedicated virtual or physical switch, a private subnet, and an environment not reachable from the internet' },
      { szoveg: 'There is no crossover between segments—one client’s environment cannot see another’s' },
    ],
    hivatkozas: { szoveg: 'The isolation diagram and real-world examples', url: '/en/case-studies/' },
  },
  {
    cimke: 'Identity',
    cim: 'A stolen password alone should not be enough',
    allitas: [
      'Signing in is exactly as easy for an attacker as for a colleague—if only a password stands in the way. The second common mistake is not at sign-in but after it: in most companies, nobody can say exactly what a given account actually has access to.',
      'That is why we ask for two things at once: multi-factor authentication for sign-in, and a documented, maintained permission structure behind it. The accounts and devices of joining and departing employees are added and removed by a defined process—not from memory.',
    ],
    kulcs: 'Permissions become a risk when nobody knows anymore who has access to what.',
    reszletek: [
      { cimke: 'Authentication', szoveg: 'multi-factor authentication, centralized permission management' },
      { cimke: 'Directory', szoveg: 'Active Directory domain, Group Policy, redundant domain controllers' },
      { cimke: 'Lifecycle', szoveg: 'account and device management for joining and departing employees, with a documented permission structure' },
      { cimke: 'Cloud', szoveg: 'Microsoft 365 and Entra ID administration, email and phishing protection' },
      { szoveg: 'Only authorized Triox staff have access to the infrastructure, to the extent required for operations' },
    ],
    hivatkozas: {
      szoveg: 'What an office AI assistant actually sees—and why it is about permissions',
      url: '/en/blog/ai-in-the-office-permissions/',
    },
  },
  {
    cimke: 'Endpoint',
    cim: 'The attack does not start on the server',
    allitas: [
      'In the vast majority of cases, the entry point is a workstation: an opened attachment, an outdated browser extension, an application that has not been updated in two years. The server is only the second stop.',
      'Endpoints run protection that is monitored from a central console, and patch management is a scheduled, tested and traceable process—tied to a maintenance window, not ad hoc clicking. Devices are inventoried, and their lifecycle is tracked.',
    ],
    kulcs: 'What nobody watches keeps working—until it doesn’t.',
    reszletek: [
      { cimke: 'Endpoint protection', szoveg: 'deployment and monitoring from a central console, on workstations and servers' },
      { cimke: 'Patch management', szoveg: 'scheduled installation of Windows and Linux patches, tied to a maintenance window (WSUS- or RMM-based)' },
      { cimke: 'Remote management', szoveg: 'RMM: endpoint and server monitoring, remote intervention, device inventory' },
      { cimke: 'Device lifecycle', szoveg: 'inventory, warranty and support tracking, replacement planning' },
    ],
    hivatkozas: {
      szoveg: 'Endpoint monitoring is part of managed IT operations',
      url: '/en/services/managed-it-operations/',
    },
  },
  {
    cimke: 'Data',
    cim: 'Ransomware goes after the backup too',
    allitas: [
      'The first target of an encryption attack is not the data but the backup. If the backup sits on the same network, in the same rack or in the same building as the production system, a single event takes out both.',
      'That is why, with us, backup is not a by-product of the production system but separate infrastructure: multiple, physically independent targets at two sites. Critical workloads also have an off-site VM replica—it does not need to be restored, only started.',
    ],
    kulcs: 'The question is not whether there is a backup. It is where it is, and how long it takes to be up and running.',
    reszletek: [
      { cimke: 'Backup platform', szoveg: 'Veeam Backup & Replication and Veeam Agent; alternatively Synology, Iperius and BackupChain solutions' },
      { cimke: 'Targets', szoveg: 'primary repository and separate physical secondary backup targets, on independent devices, at two sites' },
      { cimke: '3-2-1 rule', szoveg: '3 copies, on 2 different media, 1 off-site' },
      { cimke: 'Replication', szoveg: 'off-site, ready-to-run VM replica for critical workloads' },
      { cimke: 'Application-aware backup', szoveg: 'database- and mail-system-consistent backups, not just file-level copies' },
      { cimke: 'Verification', szoveg: 'daily verification of backup jobs—not just that they started, but that they also completed' },
    ],
    hivatkozas: {
      szoveg: 'A test proves that the backup can actually be restored',
      url: '/en/services/audit-restore-validation/',
    },
  },
  {
    cimke: 'Management plane',
    cim: 'What cannot be reached from the internet cannot be hacked from there',
    allitas: [
      'The security of an infrastructure is often decided not at the application but by where the management interfaces of the servers, the hypervisor and the network devices can be reached from. This is the shortest path to the entire environment—and an exposed management interface can be probed by the whole internet.',
      'Triox’s management network is dedicated and not reachable from the internet. No management interface is exposed that a password would have to protect. Client access goes through VPN, via a dedicated endpoint per client.',
    ],
    kulcs: 'The best-protected management interface is the one that is not exposed.',
    reszletek: [
      { cimke: 'Out-of-band management', szoveg: 'dedicated management network, not reachable from the internet' },
      { cimke: 'Hardware level', szoveg: 'iDRAC and iLO—the server can be managed and monitored even if the operating system does not start' },
      { cimke: 'Early warning', szoveg: 'power supply, fan, memory and disk faults are in many cases detected before an actual failure' },
      { cimke: 'Client access', szoveg: 'through VPN, via a dedicated endpoint per client' },
      { szoveg: 'Up-to-date, transferable and auditable system documentation—not in the operator’s head' },
    ],
    hivatkozas: { szoveg: 'Who has access to my data?—FAQ', url: '/en/faq/' },
  },
];

/** Hero alatti gyorsnézet. Minden szám máshol is szerepel az oldalon. */
const gyorsnezet = [
  { ertek: '1 client = 1 network', szoveg: 'client-level isolation with a dedicated gateway' },
  { ertek: '2 sites', szoveg: 'Budapest data centers, independent of each other' },
  { ertek: '3 · 2 · 1', szoveg: 'copies, media, off-site copy' },
  { ertek: '0 exposed management interfaces', szoveg: 'the management network is not reachable from the internet' },
];

const kockazatok = [
  {
    kockazat: 'Ransomware',
    nelkule: 'A backup reachable over the network gets encrypted along with the production data.',
    valasz: 'Multiple physically independent backup targets at two sites, plus an off-site VM replica.',
    link: { szoveg: 'Backup and replication', url: '/en/services/on-premises-and-hybrid-it/' },
  },
  {
    kockazat: 'Phishing, AI-based impersonation',
    nelkule: 'One email or call that is indistinguishable from the real thing is enough to trigger a payment.',
    valasz: 'Multi-factor authentication, email and phishing protection, and a written internal procedure before payments.',
    link: { szoveg: 'When the scammer calls in your boss’s voice', url: '/en/blog/ai-voice-cloning-fraud/' },
  },
  {
    kockazat: 'Stolen password',
    nelkule: 'Signing in is just as easy for the attacker as for a colleague.',
    valasz: 'Multi-factor authentication, and support for rolling out passwordless sign-in, starting with critical accounts.',
    link: { szoveg: 'The password that cannot be stolen', url: '/en/blog/passkeys-passwordless-sign-in/' },
  },
  {
    kockazat: 'Overly broad permissions',
    nelkule: 'Compromising a single account exposes the entire file server.',
    valasz: 'Centralized permission management, a documented structure, an onboarding and offboarding process.',
    link: { szoveg: 'AI in the office: what does it actually see?', url: '/en/blog/ai-in-the-office-permissions/' },
  },
  {
    kockazat: 'Compromise of a public-facing service',
    nelkule: 'The attacker reaches the database directly from the web server.',
    valasz: 'Two-tier segmentation and a dedicated gateway per client—the public layer has no line of sight to the internal one.',
    link: { szoveg: 'Client isolation', url: '/en/technology/' },
  },
  {
    kockazat: 'Exposed management interface',
    nelkule: 'The whole internet can probe the management interface.',
    valasz: 'Dedicated out-of-band management network, not reachable from the internet.',
    link: { szoveg: 'Management access', url: '/en/technology/' },
  },
  {
    kockazat: 'Backup that does not work',
    nelkule: 'The problem surfaces during the restore—when it is already too late.',
    valasz: 'Daily backup verification, plus documented restore testing as a separate service, with a written report.',
    link: { szoveg: 'Audit Restore Validation', url: '/en/services/audit-restore-validation/' },
  },
  {
    kockazat: 'Key-person dependency',
    nelkule: 'The knowledge lives in a single head—and that head goes on vacation or quits.',
    valasz: 'A documented, transferable environment with a team behind it, not a single colleague.',
    link: { szoveg: 'Managed IT operations', url: '/en/services/managed-it-operations/' },
  },
  {
    kockazat: 'Fire, water damage, extended power outage',
    nelkule: 'The production system and the backup next to it go down at the same time.',
    valasz: 'Two data center sites in Budapest, an off-site copy and a ready-to-run replica.',
    link: { szoveg: 'About us—in numbers', url: '/en/about/' },
  },
  {
    kockazat: 'License audit',
    nelkule: 'Proving the correct license count is your risk, and the fine is yours.',
    valasz: 'Under an SPLA agreement, the service provider reports monthly and is responsible for it.',
    link: { szoveg: 'SPLA and CSP', url: '/en/services/iaas/' },
  },
];

/**
 * Felelősségi mátrix. A jelölés: T = Triox, K = közös, O = az ügyfélé.
 * A táblázat tájékoztató — a végleges határt mindig a szerződés rögzíti,
 * ezt a láblécjegyzet ki is mondja.
 */
type Felelos = 'T' | 'K' | 'O';

const jeloles: Record<Felelos, { jel: string; sz: string }> = {
  T: { jel: '●', sz: 'Triox’s responsibility' },
  K: { jel: '◐', sz: 'Shared, per the contract' },
  O: { jel: '○', sz: 'Stays on your side' },
};

const modellek = ['IaaS', 'DCaaS', 'SaaS', 'On-premises and hybrid'];

const matrix: { terulet: string; ertekek: Felelos[] }[] = [
  { terulet: 'Physical environment: data hall, power, cooling', ertekek: ['T', 'T', 'T', 'O'] },
  { terulet: 'Network edge: gateway, firewall, VPN', ertekek: ['T', 'T', 'T', 'T'] },
  { terulet: 'Network segmentation', ertekek: ['T', 'T', 'T', 'T'] },
  { terulet: 'Server hardware and hypervisor', ertekek: ['T', 'T', 'T', 'K'] },
  { terulet: 'Operating system installation and updates', ertekek: ['O', 'T', 'T', 'T'] },
  { terulet: 'Business application and its configuration', ertekek: ['O', 'O', 'T', 'K'] },
  { terulet: 'Running the backups', ertekek: ['T', 'T', 'T', 'T'] },
  { terulet: 'Restore test and report', ertekek: ['K', 'K', 'K', 'K'] },
  { terulet: 'User accounts and permissions', ertekek: ['O', 'K', 'K', 'K'] },
  { terulet: 'Workstations and endpoint protection', ertekek: ['O', 'O', 'O', 'K'] },
  { terulet: 'Content of the data and its lawful use', ertekek: ['O', 'O', 'O', 'O'] },
];

const nemAllitjuk = [
  {
    cim: 'We do not claim that an incident cannot happen with us',
    szoveg:
      'Anyone who promises that has either not run enough systems or is not telling the truth. What we do claim is that we are prepared for it, that an event stays within a single client’s segment, and that there is something to fall back on.',
  },
  {
    cim: 'We do not publish an availability percentage on our website',
    szoveg:
      'The committed availability and response time depend on the service you choose, and we set them in the service level agreement (SLA)—that is where they can be measured and enforced. A marketing number on the home page cannot.',
  },
  {
    cim: 'We cite a certification only when there is an audit finding behind it',
    szoveg:
      'What you read on this page is working practice, not a statement of intent. If a compliance requirement has to be met with a specific certification, tell us during the assessment—we will look at what we can add and what we cannot.',
  },
  {
    cim: 'A purchased tool is not protection on its own',
    szoveg:
      'We do not sell security products that nobody has the capacity to monitor day to day. What is not monitored and updated does not protect—at most, it reassures.',
  },
];
---

<Base
  cim="Security"
  leiras="Seven layers: a physically protected data center, a dedicated gateway per client, two-tier segmentation, multi-factor authentication, endpoint protection, independent backups and out-of-band management. Triox’s approach to security, with a responsibility matrix."
>
  <section class="band">
    <div class="wrap">
      <div class="hero">
        <p class="eyebrow">Security</p>
        <h1>Protection is not a product. It is seven layers, and each one has its own job</h1>
        <p class="lead">
          Every client of ours runs on its own network segment, behind a dedicated gateway. That is
          the foundation. The other layers build on it: identity, endpoint, data, and the management
          plane, which cannot be reached from the internet at all.
        </p>
      </div>

      <ul class="gyorsnezet">
        {gyorsnezet.map((g) => (
          <li>
            <span class="gyorsnezet__ertek">{g.ertek}</span>
            <span class="gyorsnezet__szoveg">{g.szoveg}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap">
      <h2 class="szekcio__cim">The layers of protection</h2>
      <p class="szekcio__lead">
        The layers are independent of each other: there is not one strong wall in front of the
        environment but seven, one after another, and any one of them can stop an event on its own.
        The diagram below goes from the outside in—and we break the layers down in the same order
        further below.
      </p>

      <figure class="abra">
        <svg viewBox="0 0 880 420" role="img" aria-labelledby="abra-retegek">
          <title id="abra-retegek">
            The seven layers of protection, from the outside in. Physical layer: two data center
            sites in Budapest, with physically protected data halls, redundant power and cooling.
            Network edge: a dedicated gateway per client with its own firewall, NAT and VPN rules
            and its own public IP. Segmentation: a two-tier network separated per client, so a
            compromised public layer does not open a path to the databases. Identity: multi-factor
            authentication and centralized permission management, so a stolen password alone is not
            enough. Endpoint: endpoint protection and scheduled patch management, because attacks
            typically start on a workstation. Data: multiple independent backup targets and an
            off-site replica, because ransomware goes after the backup too. Management plane:
            out-of-band management, not reachable from the internet. Breaching one layer does not
            mean losing the environment.
          </title>

          <text class="abra__mono" x="0" y="14">SEVEN LAYERS OF PROTECTION—OUTSIDE IN</text>

          <rect class="abra__sav" x="0" y="30" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="59">01 · PHYSICAL</text>
          <rect class="abra__doboz" x="258" y="30" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="52">Two data center sites in Budapest</text>
          <text class="abra__kicsi" x="276" y="69">physically protected data hall, redundant power and cooling—not an office closet</text>

          <rect class="abra__sav" x="0" y="82" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="111">02 · NETWORK EDGE</text>
          <rect class="abra__doboz" x="258" y="82" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="104">Dedicated gateway per client</text>
          <text class="abra__kicsi" x="276" y="121">own firewall, NAT and VPN rules, own public IP—not a shared template</text>

          <rect class="abra__sav" x="0" y="134" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="163">03 · SEGMENTATION</text>
          <rect class="abra__kiemelt" x="258" y="134" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="156">Two-tier network, separated per client</text>
          <text class="abra__kicsi" x="276" y="173">a compromised public layer does not open a path to the databases</text>

          <rect class="abra__sav" x="0" y="186" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="215">04 · IDENTITY</text>
          <rect class="abra__doboz" x="258" y="186" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="208">Multi-factor authentication, central access control</text>
          <text class="abra__kicsi" x="276" y="225">a stolen password alone is not enough to get in</text>

          <rect class="abra__sav" x="0" y="238" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="267">05 · DEVICES</text>
          <rect class="abra__doboz" x="258" y="238" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="260">Endpoint protection and scheduled patching</text>
          <text class="abra__kicsi" x="276" y="277">attacks typically start on a workstation, not on the server</text>

          <rect class="abra__sav" x="0" y="290" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="319">06 · DATA</text>
          <rect class="abra__doboz" x="258" y="290" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="312">Independent backup targets, off-site replica</text>
          <text class="abra__kicsi" x="276" y="329">ransomware targets backups too—so they are not in one place</text>

          <rect class="abra__sav" x="0" y="342" width="250" height="48" rx="3" />
          <text class="abra__mono" x="16" y="371">07 · MGMT PLANE</text>
          <rect class="abra__kiemelt" x="258" y="342" width="622" height="48" rx="3" />
          <text class="abra__cimke" x="276" y="364">Out-of-band management, not exposed to the internet</text>
          <text class="abra__kicsi" x="276" y="381">no one outside can probe the interface, because it is not exposed</text>

          <text class="abra__mono" x="440" y="412" text-anchor="middle">A BREACHED LAYER IS NOT A LOST ENVIRONMENT</text>
        </svg>
      </figure>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="szekcio__cim">Layer by layer</h2>
      <p class="szekcio__lead">
        Each layer follows the same structure: what the specific risk is, what we do about it, and
        what technical solution stands behind it. The technical details can be expanded.
      </p>

      <div class="rkartyak">
        {retegek.map((r, i) => (
          <article class="rkartya">
            <div class="rkartya__fej">
              <span class="rkartya__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="rkartya__cimke">{r.cimke}</span>
            </div>

            <h3>{r.cim}</h3>

            {r.allitas.map((bek) => <p>{bek}</p>)}

            <p class="rkartya__kulcs">{r.kulcs}</p>

            {r.hivatkozas && (
              <p class="rkartya__hiv"><a href={r.hivatkozas.url}>{r.hivatkozas.szoveg} →</a></p>
            )}

            <details class="reszletek">
              <summary>Technical details</summary>
              <ul>
                {r.reszletek.map((d) => (
                  <li>
                    {d.cimke && <strong>{d.cimke}:</strong>}
                    {' '}{d.szoveg}
                  </li>
                ))}
              </ul>
            </details>
          </article>
        ))}
      </div>
    </div>
