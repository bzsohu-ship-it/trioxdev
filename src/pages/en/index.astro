---
import { szolgaltatasSorok } from '../../i18n/szolgaltatas-lista';
import Base from '../../layouts/Base.astro';
import Allapottabla from '../../components/Allapottabla.astro';

// A hat fő szolgáltatás + a kiegészítő oldalak (pl. SOX) — lásd src/i18n/szolgaltatas-lista.ts
const szolgaltatasok = await szolgaltatasSorok('en');

const allitasok = [
  {
    cim: 'Every client on its own network',
    szoveg: 'You share it with no one. VLAN-based or physical segmentation, with a dedicated gateway per client and its own firewall and NAT rules.',
  },
  {
    cim: 'Two data centers, redundant network',
    szoveg: 'Two data centers in Budapest, a redundant 2×10 Gbps backbone, and independent backups stored at multiple sites.',
  },
  {
    cim: 'No rigid packages',
    szoveg: 'We don’t sell templates. We size the infrastructure to your workload—from a small application stack to an enterprise-scale environment.',
  },
];
---

<Base
  cim="Managed IT infrastructure and hosting"
  leiras="Triox Informatika Kft.—managed IT infrastructure and hosting from Hungarian experts. On our own servers, in a dedicated, isolated environment for each client."
>
  <section class="hero band">
    <img class="vizjel vizjel--hero" src="/logo.svg" alt="" aria-hidden="true" />
    <div class="wrap hero__in">
      <div>
        <p class="eyebrow">Managed IT infrastructure</p>
        <h1>Professional, enterprise-grade IT operations</h1>
        <p class="lead">
          Enterprise infrastructure solutions at small-business prices.
        </p>
        <p class="alcim">
          Managed IT infrastructure and hosting from Hungarian experts. On our own servers, in a dedicated, isolated environment for each client.
        </p>
        <p class="hero__gombok">
          <a class="btn" href="/en/contact/">Request a quote</a>
          <a class="btn btn--ghost" href="/en/contact/">Let’s talk about your infrastructure</a>
        </p>
      </div>
      <Allapottabla />
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap harom">
      {allitasok.map((a) => (
        <div>
          <h3>{a.cim}</h3>
          <p>{a.szoveg}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h2>What we take off your hands</h2>
      <div class="rows">
        {szolgaltatasok.map((sz, i) => (
          <a class="row" href={sz.href}>
            <span class="row__idx">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row__title">{sz.cim}</span>
              <span class="row__desc">{sz.osszefoglalo}</span>
            </span>
            <span class="row__meta">{sz.cimke ?? 'details →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--sotet">
    <img class="vizjel vizjel--cta" src="/logo-feher.svg" alt="" aria-hidden="true" />
    <div class="wrap cta">
      <h2>Let’s see where your systems stand today</h2>
      <p class="lead">
        A short assessment shows your biggest risk and what it would cost to eliminate it.
      </p>
      <a class="btn" href="/en/contact/">Request a quote</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  /* Halvány, nagy jel a hero mögött — periférián érzékelhető textúra. */
  .vizjel--hero {
    right: -6rem;
    bottom: -8rem;
    width: 34rem;
    opacity: 0.04;
  }
  .vizjel--cta {
    right: -4rem;
    bottom: -6rem;
    width: 22rem;
    opacity: 0.07;
  }
  .hero__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__gombok {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .alcim {
    color: var(--c-steel);
    font-size: 0.95rem;
    margin-top: -0.5rem;
  }
  .harom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
  }
  .cta {
    text-align: center;
  }
  .cta .lead {
    margin-inline: auto;
  }
  @media (max-width: 52rem) {
    .hero__in {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 34rem) {
    .hero__gombok .btn {
      width: 100%;
      justify-content: center;
    }
    .harom {
      gap: 1.5rem;
    }
  }
</style>
