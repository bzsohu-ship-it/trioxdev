---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

const lista = (await getCollection('szolgaltatasokEn')).sort(
  (a, b) => a.data.sorrend - b.data.sorrend
);
---

<Base cim="Services" leiras="IT systems management, cloud, data backup, audit, DRP and hosting—services from Triox Informatika.">
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>What we take off your hands</h1>
      <p class="lead">Each service is available on its own, but for most of our clients they come together as one working operations setup.</p>
      <div class="rows">
        {lista.map((sz, i) => (
          <a class="row" href={`/en/services/${sz.id}/`}>
            <span class="row__idx">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row__title">{sz.data.cim}</span>
              <span class="row__desc">{sz.data.osszefoglalo}</span>
            </span>
            <span class="row__meta">{sz.data.cimke ?? 'details →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
