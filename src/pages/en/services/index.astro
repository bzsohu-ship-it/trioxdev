---
import { szolgaltatasSorok } from '../../../i18n/szolgaltatas-lista';
import Base from '../../../layouts/Base.astro';

// A hat fő szolgáltatás + a kiegészítő oldalak (pl. SOX) — lásd src/i18n/szolgaltatas-lista.ts
const lista = await szolgaltatasSorok('en');
---

<Base cim="Services" leiras="IT systems management, cloud, data backup, audit, DRP and hosting—services from Triox Informatika.">
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>What we take off your hands</h1>
      <p class="lead">Each service is available on its own, but for most of our clients they come together as one working operations setup.</p>
      <div class="rows">
        {lista.map((sz, i) => (
          <a class="row" href={sz.href}>
            <span class="row__idx">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row__title">{sz.cim}</span>
              <span class="row__desc">{sz.osszefoglalo}</span>
            </span>
            <span class="row__meta">{sz.cimke ?? 'details →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
