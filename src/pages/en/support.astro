---
import Base from '../../layouts/Base.astro';
---

<Base cim="Support" leiras="Issue reporting, remote assistance and contact details for our existing clients.">
  <section class="band">
    <div class="wrap prose">
      <p class="eyebrow">Support</p>
      <h1>Reporting an issue</h1>
      <p>For our existing clients. In urgent cases, please call us.</p>
      <h2>Remote assistance</h2>
      <p>
        Start the <a href="https://rd.triox.hu">support module</a>,
        then read us the ID it displays.
      </p>
      <h2>Reporting by email</h2>
      <p>
        <a href="mailto:ticket@triox.hu">ticket@triox.hu</a>—tell us which computer is affected,
        since when, and exactly what you are seeing. Your email automatically becomes a ticket,
        and we send you a confirmation with the ticket number.
      </p>
      <p>
        This address accepts messages from the registered contacts of your company. If your address
        is not yet on file with us, write to <a href="mailto:info@triox.hu">info@triox.hu</a>
        instead—we log the report from there as well.
      </p>
      <p><em>Business hours and committed response times will be listed here.</em></p>
    </div>
  </section>
</Base>
