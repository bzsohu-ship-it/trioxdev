---
import { szolgaltatasSorok } from '../../i18n/szolgaltatas-lista';
import Base from '../../layouts/Base.astro';

// A hat fő szolgáltatás + a kiegészítő oldalak (pl. SOX) — lásd src/i18n/szolgaltatas-lista.ts
const lista = await szolgaltatasSorok('hu');
---

<Base cim="Szolgáltatások" leiras="IT rendszerfelügyelet, felhő, adatmentés, audit, DRP és hoszting — a Triox Informatika szolgáltatásai.">
  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Szolgáltatások</p>
      <h1>Amit átveszünk Öntől</h1>
      <p class="lead">Külön-külön is kérhető, de a legtöbb ügyfelünknél ezek együtt adnak ki egy működő üzemeltetést.</p>
      <div class="rows">
        {lista.map((sz, i) => (
          <a class="row" href={sz.href}>
            <span class="row__idx">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row__title">{sz.cim}</span>
              <span class="row__desc">{sz.osszefoglalo}</span>
            </span>
            <span class="row__meta">{sz.cimke ?? 'részletek →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
