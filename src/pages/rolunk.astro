    </div>
  </article>
</Base>

<style>
  .wrap-szeles {
    width: 100%;
    max-width: var(--w-max);
    margin-inline: auto;
    padding-inline: var(--pad);
    padding-block: 3rem;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--c-steel);
    max-width: 52rem;
    margin-top: 0.75rem;
  }

  .blokk {
    margin-top: 3rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--c-line);
  }

  .blokk h2 {
    margin-bottom: 1rem;
  }

  .blokk ul {
    padding-left: 1.2rem;
  }

  .blokk li {
    margin-bottom: 0.4rem;
  }

  .blokk blockquote {
    border-left: 4px solid var(--c-brand);
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--c-brand-wash);
    border-radius: 0 var(--r) var(--r) 0;
    color: var(--c-ink);
    font-size: 0.95rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    margin-block: 1.25rem;
  }

  th, td {
    text-align: left;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--c-line);
    vertical-align: top;
  }

  th {
    background: var(--c-ink);
    color: #e9ecf2;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  tr:nth-child(even) td {
    background: var(--c-mist);
  }

  .szamok td:first-child {
    font-family: var(--f-display);
    font-size: 1.05rem;
    white-space: nowrap;
    width: 12rem;
  }

  .kapcsolat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1rem;
  }

  @media (max-width: 52rem) {
    table {
      display: block;
      overflow-x: auto;
    }

    .kapcsolat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
