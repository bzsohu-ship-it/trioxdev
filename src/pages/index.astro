---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Allapottabla from '../components/Allapottabla.astro';

const szolgaltatasok = (await getCollection('szolgaltatasok')).sort(
  (a, b) => a.data.sorrend - b.data.sorrend
);

const allitasok = [
  {
    cim: 'Minden ügyfél saját hálózaton',
    szoveg: 'Nem osztozik senkivel. VLAN-alapú vagy fizikai szegmentálás, ügyfelenként dedikált gateway saját tűzfal- és NAT-szabályokkal.',
  },
  {
    cim: '99,99% rendelkezésre állás',
    szoveg: 'Két budapesti datacenter, redundáns 2×10 Gbps gerinchálózat, több helyszínen tárolt, egymástól független mentések.',
  },
  {
    cim: 'Nincs merev csomagkényszer',
    szoveg: 'Nem sablonokat árulunk. Az infrastruktúrát az Ön terheléséhez szabjuk — a kis alkalmazás-stacktől a nagyvállalati méretű környezetig.',
  },
];
---

<Base
  cim="Menedzselt IT infrastruktúra és hosting"
  leiras="Triox Informatika Kft. — menedzselt IT infrastruktúra és hosting magyar szakértőktől. Saját szervereken, ügyfelenként dedikált, izolált környezetben."
>
  <section class="hero band">
    <div class="wrap hero__in">
      <div>
        <p class="eyebrow">Menedzselt IT infrastruktúra</p>
        <h1>Professzionális, vállalati IT üzemeltetés</h1>
        <p class="lead">
          Nagyvállalati (Enterprise) infrastruktúra megoldások, kisvállalati árakon.
        </p>
        <p class="alcim">
          Menedzselt IT infrastruktúra és hosting magyar szakértőktől. Saját szervereken, ügyfelenként dedikált, izolált környezetben.
        </p>
        <p>
          <a class="btn" href="/kapcsolat/">Kérjen ajánlatot</a>
          <a class="btn btn--ghost" href="/kapcsolat/">Beszéljünk az infrastruktúrájáról</a>
        </p>
      </div>
      <Allapottabla />
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap harom">
      {allitasok.map((a) => (
        <div>
          <h3>{a.cim}</h3>
          <p>{a.szoveg}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="eyebrow">Szolgáltatások</p>
      <h2>Amit átveszünk Öntől</h2>
      <div class="rows">
        {szolgaltatasok.map((sz, i) => (
          <a class="row" href={`/szolgaltatasok/${sz.id}/`}>
            <span class="row__idx">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="row__title">{sz.data.cim}</span>
              <span class="row__desc">{sz.data.osszefoglalo}</span>
            </span>
            <span class="row__meta">{sz.data.cimke ?? 'részletek →'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--mist">
    <div class="wrap cta">
      <h2>Nézzük meg, hol áll most a rendszere</h2>
      <p class="lead">
        Egy rövid felmérésből kiderül, mi a legnagyobb kockázat, és mennyibe kerül megszüntetni.
      </p>
      <a class="btn" href="/kapcsolat/">Kérjen ajánlatot</a>
    </div>
  </section>
</Base>

<style>
  .hero__in {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero .btn {
    margin-right: 0.6rem;
  }
  .alcim {
    color: var(--c-steel);
    font-size: 0.95rem;
    margin-top: -0.5rem;
  }
  .harom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 2rem;
  }
  .cta {
    text-align: center;
  }
  .cta .lead {
    margin-inline: auto;
  }
  @media (max-width: 52rem) {
    .hero__in {
      grid-template-columns: 1fr;
    }
  }
</style>
